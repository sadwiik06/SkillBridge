# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/skillbridge?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Security (JWT Secret key min 256 bits)
JWT_SECRET=YourSuperSecretKeyWithAtLeast256BitsLength1234567890!@#

# Cloudinary Configuration (Image / Profile uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (AI assistance)
GEMINI_API_KEY=your_gemini_api_key_here

